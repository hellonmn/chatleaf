# ──────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env`.
# ──────────────────────────────────────────────────────────────

# --- Database (Postgres) ---
# Local docker-compose default:
DATABASE_URL="postgresql://watool:watool@localhost:5432/watool?schema=public"
# Or a managed Neon URL:
# DATABASE_URL="postgresql://USER:PASS@HOST/db?sslmode=require"

# --- Redis (BullMQ queue) — Phase 1+ ---
# Local docker-compose default, OR an Upstash "Redis" (rediss://) URL — NOT the REST URL.
REDIS_URL="redis://localhost:6379"

# --- Auth.js / NextAuth ---
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
AUTH_SECRET="replace-with-a-long-random-string"
# Base URL of the web app
NEXTAUTH_URL="http://localhost:3000"

# --- Encryption for tenant secrets (Meta tokens), added Phase 1 ---
# 32-byte hex key: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ENCRYPTION_KEY="replace-with-32-byte-hex-key"

# --- WhatsApp Cloud API (Meta) — Phase 1 ---
# App secret (Meta → App → Settings → Basic) — used to verify webhook signatures.
META_APP_SECRET="replace-with-meta-app-secret"
# Any random string you choose; paste the SAME value into Meta's webhook config.
META_WEBHOOK_VERIFY_TOKEN="replace-with-a-random-verify-token"
META_GRAPH_API_VERSION="v21.0"
META_APP_ID=""

# NOTE: in this monorepo each app reads its OWN .env:
#   - apps/web/.env     (Next.js)        : all of the above
#   - apps/worker/.env  (BullMQ worker)  : DATABASE_URL, REDIS_URL, ENCRYPTION_KEY, META_GRAPH_API_VERSION
#   - packages/db/.env  (Prisma CLI)     : DATABASE_URL (direct, non-pooled endpoint)
