// WhatsApp Chatbot Portal — data model.
// See ARCHITECTURE.md §6. Phase 0 ships the tenancy/auth core; WhatsApp,
// flow, and broadcast models are defined now so later phases just fill them in.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tenancy & auth ────────────────────────────────────────────────────────

enum Plan {
  FREE
  STARTER
  PRO
}

enum Role {
  OWNER
  ADMIN
  AGENT
  ANALYST
}

model Org {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  suspendedAt DateTime? // set by a platform admin to lock the org out of the app
  adminNotes  String?  // internal platform-admin notes (never shown to the org)
  seatLimitOverride Int? // when set, overrides the plan's seat limit for this org
  gstin       String?  // buyer GSTIN, shown on tax invoices
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  invites          Invite[]
  whatsAppAccounts WhatsAppAccount[]
  contacts         Contact[]
  tags             Tag[]
  segments         Segment[]
  conversations    Conversation[]
  messages         Message[]
  templates        Template[]
  flows            Flow[]
  flowRuns         FlowRun[]
  broadcasts       Broadcast[]
  savedReplies     SavedReply[]
  settings         OrgSettings?
  subscription     Subscription?
  paymentLinks     PaymentLink[]
  invoices         Invoice[]
  wallet           Wallet?
  pipelines        Pipeline[]
  deals            Deal[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  isPlatformAdmin Boolean @default(false) // SaaS operator: cross-org access via /admin
  disabledAt   DateTime? // set by a platform admin to block this user from logging in
  spotlightSeenVersion Int @default(0) // last "what's new" spotlight version dismissed
  twoFactorSecret  String?  // encrypted TOTP secret (set during 2FA enrollment)
  twoFactorEnabled Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships         Membership[]
  assignedConversations Conversation[] @relation("AssignedAgent")
}

/// Razorpay subscription state for an org (1:1). Org.plan stays the source of
/// truth for limits; webhooks flip it when a subscription activates/ends.
model Subscription {
  id                     String    @id @default(cuid())
  orgId                  String    @unique
  provider               String    @default("razorpay")
  razorpaySubscriptionId String?   @unique
  razorpayCustomerId     String?
  plan                   Plan // the tier this subscription pays for
  status                 String    @default("created") // created|authenticated|active|halted|cancelled|completed
  currentEnd             DateTime? // end of the paid period
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// Prepaid wallet (one per org). Holds a balance in paise that the org tops up
/// via Razorpay and that usage (WhatsApp messages, AI, etc.) draws down. This is
/// the platform-managed "add funds" model — see WalletTransaction for the ledger.
model Wallet {
  id                       String   @id @default(cuid())
  orgId                    String   @unique
  balancePaise             Int      @default(0) // current balance, in paise
  currency                 String   @default("INR")
  lowBalanceThresholdPaise Int      @default(10000) // warn below ₹100 by default
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  org          Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

/// Immutable ledger entry for every wallet credit/debit. `balanceAfterPaise` is
/// the wallet balance right after this entry, so history is self-describing.
model WalletTransaction {
  id                String        @id @default(cuid())
  walletId          String
  orgId             String // denormalised for cheap org-scoped queries
  type              WalletTxnType
  amountPaise       Int // always positive; `type` says credit or debit
  balanceAfterPaise Int
  kind              String // topup | message | adjustment | refund | bonus
  note              String?
  refType           String? // message | broadcast | razorpay | admin
  refId             String?
  razorpayPaymentId String?
  createdAt         DateTime      @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

enum WalletTxnType {
  CREDIT
  DEBIT
}

/// Admin-editable pricing + limits per plan tier. One row per Plan enum value;
/// missing values fall back to the hardcoded defaults in @watool/types.
model PlanConfig {
  plan             Plan     @id
  priceInr         Int
  seats            Int
  contacts         Int
  messagesPerMonth Int
  publishedFlows   Int
  razorpayPlanId   String?
  trialDays        Int      @default(0) // free-trial length before first charge
  active           Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

/// A Razorpay Payment Link sent to a contact inside a conversation. Status is
/// reconciled from payment_link.* webhooks. Amount is in paise.
model PaymentLink {
  id              String    @id @default(cuid())
  orgId           String
  conversationId  String?
  contactId       String?
  razorpayLinkId  String    @unique
  shortUrl        String
  amount          Int // paise
  description     String?
  status          String    @default("created") // created|paid|cancelled|expired
  createdByUserId String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([conversationId])
}

/// Discount codes. Map an app-facing code to a Razorpay Offer applied at
/// checkout. Razorpay computes the actual discount; we track usage + validity.
model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  razorpayOfferId String? // Razorpay Offer id (offer_…) applied to the subscription
  description     String?
  active          Boolean   @default(true)
  maxRedemptions  Int?
  redeemedCount   Int       @default(0)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Global platform configuration (singleton, id="global"): white-label branding
/// and feature on/off flags the operator controls from /admin/settings.
model PlatformSettings {
  id                String   @id @default("global")
  brandName         String   @default("Chatleaf")
  logoUrl           String?
  supportEmail      String?
  signupsEnabled    Boolean  @default(true)
  broadcastsEnabled Boolean  @default(true)
  flowsEnabled      Boolean  @default(true)
  templatesEnabled  Boolean  @default(true)
  aiEnabled         Boolean  @default(true)
  // GST invoicing (seller / SaaS-operator details)
  companyName    String?
  companyAddress String?
  gstin          String?
  gstPercent     Int      @default(18)
  invoicePrefix  String   @default("INV")
  // Razorpay credentials (secrets encrypted at rest; env vars are the fallback).
  // Separate test/live key sets; razorpayMode selects which is active.
  razorpayMode                 String  @default("test") // "test" | "live"
  razorpayTestKeyId            String?
  razorpayTestKeySecretEnc     String?
  razorpayTestWebhookSecretEnc String?
  razorpayLiveKeyId            String?
  razorpayLiveKeySecretEnc     String?
  razorpayLiveWebhookSecretEnc String?
  // Meta / WhatsApp webhook (override env). App secret encrypted at rest.
  metaAppId              String?
  metaVerifyToken        String?
  metaAppSecretEnc       String?
  metaSkipSignatureCheck Boolean @default(false)
  // Webhook relay: forward each inbound Meta event (raw bytes, original signature
  // preserved) to a second platform, since Meta allows only one callback URL per app.
  webhookForwardEnabled     Boolean @default(false)
  webhookForwardUrl         String?
  webhookForwardHeaderName  String?
  webhookForwardHeaderValue String?
  // Prepaid-wallet billing (reseller model). When disabled, sends are never
  // charged to the wallet. Per-category rates are in paise per message; the
  // markup is applied on top of the base rate the platform pays Meta.
  walletBillingEnabled Boolean @default(false)
  walletMarkupPercent  Int     @default(0)
  rateMarketingPaise   Int     @default(0)
  rateUtilityPaise     Int     @default(0)
  rateAuthPaise        Int     @default(0)
  rateServicePaise     Int     @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// A GST tax invoice issued to an org for a paid subscription charge. Amounts in
/// paise. Generated from the Razorpay subscription.charged webhook.
model Invoice {
  id          String   @id @default(cuid())
  orgId       String
  number      String   @unique
  razorpayPaymentId String? @unique // dedupe: one invoice per Razorpay charge
  description String
  subtotal    Int // taxable value (paise)
  gstPercent  Int
  cgst        Int
  sgst        Int
  igst        Int
  total       Int // paise (what the customer paid)
  buyerName   String
  buyerGstin  String?
  sellerName  String
  sellerGstin String?
  issuedAt    DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// "What's new" spotlight shown to users on login — a deck of slides (text /
/// video+text layouts) stored as JSON. Bumping `version` re-shows it to everyone.
model Spotlight {
  id         String   @id @default("global")
  active     Boolean  @default(false)
  version    Int      @default(1)
  slidesJSON Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// A single global banner the platform operator can show across every org's
/// dashboard (maintenance notices, outages, etc). Managed as a singleton row.
model PlatformAnnouncement {
  id        String   @id @default(cuid())
  message   String
  level     String   @default("info") // "info" | "warning"
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Append-only trail of platform-admin actions (plan changes, suspensions,
/// deletes, admin grants, impersonation). Deliberately has NO foreign keys —
/// targets (especially orgs) can be deleted, so we snapshot a human label and
/// keep the record for accountability.
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String // platform admin user id (no FK on purpose)
  actorEmail  String
  action      String // e.g. "org.plan.change", "org.suspend", "org.delete"
  targetType  String // "org" | "user"
  targetId    String
  targetLabel String? // snapshot of org name / user email at action time
  metadata    Json? // e.g. { "from": "FREE", "to": "PRO" }
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model Membership {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      Role     @default(AGENT)
  createdAt DateTime @default(now())

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Invite {
  id        String   @id @default(cuid())
  orgId     String
  email     String
  role      Role     @default(AGENT)
  token     String   @unique
  invitedBy String
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([orgId])
}

// ── WhatsApp connectivity (Phase 1) ────────────────────────────────────────

enum WaAccountStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
}

model WhatsAppAccount {
  id             String          @id @default(cuid())
  orgId          String
  wabaId         String          @unique
  businessId     String?
  accessTokenEnc String? // encrypted at rest
  tokenExpiresAt DateTime?
  status         WaAccountStatus @default(PENDING)
  lastTemplatesSyncAt DateTime? // when templates were last pulled from Meta
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  org          Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  phoneNumbers PhoneNumber[]
  templates    Template[]

  @@index([orgId])
}

model PhoneNumber {
  id                String   @id @default(cuid())
  whatsAppAccountId String
  phoneNumberId     String   @unique // Meta's phone_number_id
  displayNumber     String
  verifiedName      String?
  qualityRating     String?
  createdAt         DateTime @default(now())

  account       WhatsAppAccount @relation(fields: [whatsAppAccountId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([whatsAppAccountId])
}

// ── Contacts ────────────────────────────────────────────────────────────────

enum OptInStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum LifecycleStage {
  NEW
  QUALIFIED
  ENGAGED
  CONVERTED
}

model Contact {
  id           String      @id @default(cuid())
  orgId        String
  waId         String // WhatsApp id (phone in intl format, no +)
  name         String?
  phone        String?
  optInStatus  OptInStatus @default(UNKNOWN)
  stage        LifecycleStage @default(NEW)
  source       String? // where the lead came from (WhatsApp Ad, Website, Referral…)
  value        Int? // estimated deal value (minor unit-agnostic; shown as currency)
  notes        String? // free-text internal note shown in the inbox panel
  attributes   Json        @default("{}")
  lastInboundAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  org           Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contactTags   ContactTag[]
  conversations Conversation[]
  flowRuns      FlowRun[]
  broadcastRecipients BroadcastRecipient[]
  deals         Deal[]

  @@unique([orgId, waId])
  @@index([orgId])
}

model Tag {
  id    String @id @default(cuid())
  orgId String
  name  String

  org         Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contactTags ContactTag[]

  @@unique([orgId, name])
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

// ── CRM pipeline (deals move through configurable stages) ──────────────────

enum DealStatus {
  OPEN
  WON
  LOST
}

/// A sales pipeline (e.g. "Sales", "Onboarding"). Each org gets a default one.
model Pipeline {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  isDefault Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  deals  Deal[]

  @@index([orgId])
}

/// An ordered column in a pipeline. `won`/`lost` flag the closing stages.
model PipelineStage {
  id         String   @id @default(cuid())
  orgId      String // denormalised for cheap org-scoped guards
  pipelineId String
  name       String
  order      Int      @default(0)
  color      String   @default("#0e7490")
  won        Boolean  @default(false)
  lost       Boolean  @default(false)
  createdAt  DateTime @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId])
}

/// A deal/opportunity card that moves through a pipeline's stages. Optionally
/// linked to a contact. `valuePaise` is the deal value in paise.
model Deal {
  id             String     @id @default(cuid())
  orgId          String
  pipelineId     String
  stageId        String
  contactId      String?
  title          String
  valuePaise     Int        @default(0)
  status         DealStatus @default(OPEN)
  note           String?
  assignedUserId String?
  dueDate        DateTime?
  order          Int        @default(0) // sort within a stage
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  org        Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pipeline   Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage      PipelineStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact    Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities DealActivity[]

  @@index([orgId])
  @@index([pipelineId, stageId])
}

/// Chronological history for a deal: created, stage moves, assignment, value
/// changes, and free-text notes. `actorId` is null for system/flow events.
model DealActivity {
  id        String   @id @default(cuid())
  orgId     String
  dealId    String
  type      String // created | stage_changed | assigned | value_changed | note | won | lost
  text      String
  actorId   String? // user who did it; null = flow/system
  createdAt DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
}

model Segment {
  id         String   @id @default(cuid())
  orgId      String
  name       String
  filterJSON Json     @default("{}")
  createdAt  DateTime @default(now())

  org        Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  broadcasts Broadcast[]

  @@index([orgId])
}

/// Per-org operating hours + away auto-reply. One row per org (lazy-created).
/// `hoursJSON` shape: { mon: { enabled: bool, open: "09:00", close: "18:00" }, … }
model OrgSettings {
  id          String   @id @default(cuid())
  orgId       String   @unique
  timezone    String   @default("Asia/Kolkata")
  awayEnabled Boolean  @default(false)
  awayMessage String   @default("Thanks for your message! 🌿 Our team is away right now — we'll get back to you during business hours.")
  hoursJSON   Json     @default("{}")
  autoAssign  Boolean  @default(false)
  aiApiKeyEnc String? // encrypted Claude API key (per-org, optional)
  onboardingDismissedAt DateTime? // set when an owner/admin dismisses the first-run setup checklist
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// Reusable canned responses agents can insert in the inbox (optionally via a
/// `/shortcut`). Org-scoped; shortcuts are unique within an org when set.
model SavedReply {
  id        String   @id @default(cuid())
  orgId     String
  title     String
  shortcut  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ── Conversations & messages ────────────────────────────────────────────────

enum ConversationStatus {
  OPEN
  BOT
  AGENT
  CLOSED
}

enum MessageDirection {
  IN
  OUT
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model Conversation {
  id             String             @id @default(cuid())
  orgId          String
  contactId      String
  phoneNumberId  String
  status         ConversationStatus @default(OPEN)
  assignedUserId String?
  windowExpiresAt DateTime? // Meta 24h customer-service window
  lastMessageAt  DateTime           @default(now())
  createdAt      DateTime           @default(now())

  org          Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phoneNumber  PhoneNumber  @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("AssignedAgent", fields: [assignedUserId], references: [id])
  messages     Message[]
  flowRuns     FlowRun[]

  @@index([orgId, status])
  @@index([contactId])
}

model Message {
  id             String           @id @default(cuid())
  orgId          String
  conversationId String
  direction      MessageDirection
  waMessageId    String?          @unique
  type           String // text | image | template | interactive | ...
  payload        Json
  status         MessageStatus    @default(QUEUED)
  errorJSON      Json?
  createdAt      DateTime         @default(now())

  org          Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([orgId])
}

// ── Templates (Phase 4) ─────────────────────────────────────────────────────

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model Template {
  id                String         @id @default(cuid())
  orgId             String
  whatsAppAccountId String? // the WABA these templates belong to (null = legacy/org-wide)
  name              String
  language          String         @default("en_US")
  category          String // MARKETING | UTILITY | AUTHENTICATION
  components        Json
  metaStatus        TemplateStatus @default(DRAFT)
  metaTemplateId    String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  org        Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account    WhatsAppAccount? @relation(fields: [whatsAppAccountId], references: [id], onDelete: Cascade)
  broadcasts Broadcast[]

  @@unique([whatsAppAccountId, name, language])
  @@index([orgId])
}

// ── Flows (Phase 3) ─────────────────────────────────────────────────────────

enum FlowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FlowRunStatus {
  ACTIVE
  COMPLETED
  FAILED
  EXPIRED
}

model Flow {
  id            String     @id @default(cuid())
  orgId         String
  name          String
  status        FlowStatus @default(DRAFT)
  trigger       Json       @default("{}")
  phoneNumberId String? // channel scope (PhoneNumber id); null = all channels
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  org      Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions FlowVersion[]
  runs     FlowRun[]

  @@index([orgId])
}

model FlowVersion {
  id          String   @id @default(cuid())
  flowId      String
  version     Int
  graphJSON   Json
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  flow Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  runs FlowRun[]

  @@unique([flowId, version])
}

model FlowRun {
  id             String        @id @default(cuid())
  orgId          String
  flowId         String
  flowVersionId  String
  contactId      String
  conversationId String
  currentNodeId  String?
  state          Json          @default("{}")
  status         FlowRunStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  org          Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  flowVersion  FlowVersion  @relation(fields: [flowVersionId], references: [id])
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([conversationId])
}

// ── Broadcasts (Phase 4) ────────────────────────────────────────────────────

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
}

model Broadcast {
  id            String          @id @default(cuid())
  orgId         String
  templateId    String
  segmentId     String?
  phoneNumberId String? // channel to send from (PhoneNumber id); null = first connected
  scheduleAt    DateTime?
  status     BroadcastStatus @default(DRAFT)
  stats      Json            @default("{}")
  createdAt  DateTime        @default(now())

  org        Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template   Template             @relation(fields: [templateId], references: [id])
  segment    Segment?             @relation(fields: [segmentId], references: [id])
  recipients BroadcastRecipient[]

  @@index([orgId, status])
}

model BroadcastRecipient {
  id          String   @id @default(cuid())
  broadcastId String
  contactId   String
  status      String   @default("pending")
  waMessageId String?
  createdAt   DateTime @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
}

// ── Webhook audit (Phase 1) ─────────────────────────────────────────────────

model WebhookEvent {
  id          String    @id @default(cuid())
  orgId       String?
  raw         Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([orgId])
  @@index([createdAt])
}
